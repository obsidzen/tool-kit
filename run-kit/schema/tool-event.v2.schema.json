{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obsidzen/tool-kit/run-kit/schema/tool-event.v2.schema.json",
  "title": "Tool Event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phaseId",
    "status",
    "message"
  ],
  "properties": {
    "schemaVersion": { "const": "2" },
    "eventId": { "type": "string" },
    "tool": { "type": "string" },
    "command": { "type": "string" },
    "phaseId": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "planned", "running", "passed", "failed", "skipped", "not-applicable"
      ]
    },
    "message": { "type": "string", "minLength": 1 },
    "detail": { "type": "string" },
    "elapsedMs": { "type": "integer", "minimum": 0 },
    "errorCode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "total", "unit"],
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "unit": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["running", "passed", "failed"] }
        },
        "required": ["status"]
      },
      "then": { "required": ["attempt"] },
      "else": { "not": { "required": ["attempt"] } }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "required": ["errorCode"] }
    }
  ]
}
